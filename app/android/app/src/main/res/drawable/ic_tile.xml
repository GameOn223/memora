<?xml version="1.0" encoding="utf-8"?>
<!-- Quick Settings tile icon: the Memora mark, a stack of saved images with
     the spark on the front one. The system tints it, so only alpha matters.

     The paths are drawn where the mark was designed, which is a 16.5dp square
     sitting up and to the left of centre. The group scales that to the 20dp
     live area a system icon is meant to fill and puts its middle on the middle
     of the 24dp box. The pivot is the mark's own centre with the stroke
     counted in, 10.5 by 10, so scaling about it does not shift anything. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <group
        android:pivotX="10.5"
        android:pivotY="10"
        android:scaleX="1.21"
        android:scaleY="1.21"
        android:translateX="1.5"
        android:translateY="2">
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:pathData="M5.6,2.5 h4.8 a2.6,2.6 0 0 1 2.6,2.6 v4.8 a2.6,2.6 0 0 1 -2.6,2.6 h-4.8 a2.6,2.6 0 0 1 -2.6,-2.6 v-4.8 a2.6,2.6 0 0 1 2.6,-2.6 z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.3"
            android:strokeLineCap="round"
            android:pathData="M8.1,5 h4.8 a2.6,2.6 0 0 1 2.6,2.6 v4.8 a2.6,2.6 0 0 1 -2.6,2.6 h-4.8 a2.6,2.6 0 0 1 -2.6,-2.6 v-4.8 a2.6,2.6 0 0 1 2.6,-2.6 z" />
        <path
            android:fillColor="#00000000"
            android:strokeColor="#FFFFFFFF"
            android:strokeWidth="1.5"
            android:strokeLineCap="round"
            android:pathData="M10.6,7.5 h4.8 a2.6,2.6 0 0 1 2.6,2.6 v4.8 a2.6,2.6 0 0 1 -2.6,2.6 h-4.8 a2.6,2.6 0 0 1 -2.6,-2.6 v-4.8 a2.6,2.6 0 0 1 2.6,-2.6 z" />
        <path
            android:fillColor="#FFFFFFFF"
            android:pathData="M15.2,9 C15.2,10.2 16,11 17.2,11 C16,11 15.2,11.8 15.2,13 C15.2,11.8 14.4,11 13.2,11 C14.4,11 15.2,10.2 15.2,9 z" />
    </group>
</vector>
